# Server Configuration
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration (Supabase PostgreSQL)
# Pooled connection string (PgBouncer/Supavisor Transaction mode, typically port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string for Drizzle migrations (Direct PostgreSQL port 5432 or session pooler)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Auth & SDK
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# Restaurant Business Logic & Financials
RESTAURANT_NAME="Chaska & Chai Cafe"
CURRENCY_CODE="PKR"
CURRENCY_SYMBOL="Rs. "
SERVICE_CHARGE_PERCENT=5
TAX_PERCENT=5

# CORS Whitelist (Comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Anti-Spam Security Cooldowns (in seconds)
WAITER_COOLDOWN_SECONDS=120
ORDER_RATE_LIMIT_PER_MINUTE=5
